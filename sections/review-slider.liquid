{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .nexa-testimonials-{{ section.id }} {
    --tm-speed: 40s;
    --tm-gap: 16px;
    --tm-card-w: 340px;
    --tm-accent: #E33054;
    --tm-accent-deep: #9B1634;
    --tm-text: #1C1917;
    --tm-star: {{ section.settings.color_star | default: '#E33054' }};
    overflow: hidden;
    color: var(--tm-text);
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.8rem;
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__kicker {
    margin: 0 0 0.8rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tm-accent);
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__heading {
    margin: 0;
    color: var(--tm-text);
    font-size: 40px;
    line-height: 1.15;
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__sub {
    margin: 1rem 0 0;
    opacity: 0.72;
    font-size: 1.6rem;
    line-height: 1.5;
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: nexaTestimonialMarquee-{{ section.id }} var(--tm-speed) linear infinite;
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__viewport:hover .testimonials-marquee__track {
    animation-play-state: paused;
  }
  .nexa-testimonials-{{ section.id }} .testimonials-marquee__set {
    display: flex;
    gap: var(--tm-gap);
    padding-right: var(--tm-gap);
    flex-shrink: 0;
    align-items: stretch;
  }
  .nexa-testimonials-{{ section.id }} .tm-card {
    width: var(--tm-card-w);
    max-width: 86vw;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 2.2rem 2.2rem 2rem;
    border-radius: 18px;
    background: #ffffff;
    border: 1px solid rgba(227, 48, 84, 0.12);
    box-shadow: 0 12px 40px rgba(28, 25, 23, 0.05);
    text-align: left;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .nexa-testimonials-{{ section.id }} .tm-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(227, 48, 84, 0.14);
  }
  .nexa-testimonials-{{ section.id }} .tm-card__stars {
    display: flex;
    gap: 3px;
    color: var(--tm-star);
  }
  .nexa-testimonials-{{ section.id }} .tm-card__stars svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
  .nexa-testimonials-{{ section.id }} .tm-card__text {
    margin: 0;
    font-size: 1.55rem;
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--tm-text);
  }
  .nexa-testimonials-{{ section.id }} .tm-card__text p {
    margin: 0;
  }
  .nexa-testimonials-{{ section.id }} .tm-card__footer {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .nexa-testimonials-{{ section.id }} .tm-card__avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--tm-accent), var(--tm-accent-deep));
    color: #fff;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nexa-testimonials-{{ section.id }} .tm-card__name {
    display: block;
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.2;
    color: var(--tm-text);
  }
  .nexa-testimonials-{{ section.id }} .tm-card__meta {
    display: block;
    margin-top: 0.2rem;
    font-size: 1.2rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.62;
  }
  .nexa-testimonials-{{ section.id }} .tm-card__verified {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--tm-accent);
  }
  .nexa-testimonials-{{ section.id }} .tm-card__verified svg {
    width: 12px;
    height: 12px;
  }
  @media (prefers-reduced-motion: reduce) {
    .nexa-testimonials-{{ section.id }} .testimonials-marquee__track {
      animation: none;
    }
    .nexa-testimonials-{{ section.id }} .testimonials-marquee__viewport {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .nexa-testimonials-{{ section.id }} .testimonials-marquee__set[aria-hidden="true"] {
      display: none;
    }
  }
  @keyframes nexaTestimonialMarquee-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<div class="nexa-testimonials-{{ section.id }} testimonials-marquee color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width testimonials-marquee__header">
    {%- if section.settings.kicker != blank -%}
      <p class="testimonials-marquee__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- unless section.settings.title == blank -%}
      <h2 class="testimonials-marquee__heading {{ section.settings.heading_size }}">
        {{ section.settings.title | escape }}
      </h2>
    {%- endunless -%}
    {%- if section.settings.subheading != blank -%}
      <p class="testimonials-marquee__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="testimonials-marquee__viewport" role="region" aria-label="{{ section.settings.title | default: 'Testimonials' | escape }}">
    <div class="testimonials-marquee__track">
      {%- for i in (1..2) -%}
        <div class="testimonials-marquee__set"{% if i == 2 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              assign quote = block.settings.text
              if quote == blank
                assign quote = block.settings.title
              endif
              assign initials = ''
              assign name_parts = block.settings.customer_name | split: ' '
              for part in name_parts limit: 2
                assign letter = part | slice: 0, 1 | upcase
                assign initials = initials | append: letter
              endfor
              assign location = block.settings.city_name
              assign location_key = location | downcase | strip
              if location_key == 'verified buyer' or location_key == 'verified purchase'
                assign location = ''
              endif
            -%}
            <article class="tm-card"{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}>
              <span class="tm-card__stars" aria-label="5 out of 5 stars">
                {%- for star in (1..5) -%}
                  <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m3.5 13.2 6.3 6.1-1.5 8.6 7.7-4.1 7.7 4.1-1.5-8.6 6.3-6.1-8.6-1.2L16 4.1l-3.9 7.8z"/></svg>
                {%- endfor -%}
              </span>
              {%- if quote != blank -%}
                <div class="tm-card__text rte">{{ quote }}</div>
              {%- endif -%}
              <div class="tm-card__footer">
                {%- if initials != blank -%}
                  <div class="tm-card__avatar" aria-hidden="true">{{ initials }}</div>
                {%- endif -%}
                <div>
                  {%- if block.settings.customer_name != blank -%}
                    <span class="tm-card__name">{{ block.settings.customer_name | escape }}</span>
                  {%- endif -%}
                  {%- if location != blank -%}
                    <span class="tm-card__meta">{{ location | escape }}</span>
                  {%- endif -%}
                  <span class="tm-card__verified">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0l1.7 1.2L11.8.8l.7 2.1 2.1.7-.4 2.1L16 8l-1.8 1.3.4 2.1-2.1.7-.7 2.1-2.1-.4L8 16l-1.7-1.2-2.1.4-.7-2.1-2.1-.7.4-2.1L0 8l1.8-1.3L1.4 4.6l2.1-.7.7-2.1 2.1.4L8 0zm-.2 10.7l4.4-4.4-1.1-1.1-3.3 3.3-1.5-1.5-1.1 1.1 2.6 2.6z"/></svg>
                    Verified purchase
                  </span>
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonial",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.popup"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Reviews"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Loved by customers",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real notes from people who shop with us."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
        "type": "select",
        "id": "heading_center",
        "options": [
          {
            "value": "left",
            "label": "t:settings_schema.global.settings.text_alignment.options__1.label"
          },
          {
            "value": "center",
            "label": "t:settings_schema.global.settings.text_alignment.options__2.label"
          },
          {
            "value": "right",
            "label": "t:settings_schema.global.settings.text_alignment.options__3.label"
          }
        ],
        "default": "left",
        "label": "t:settings_schema.global.settings.text_alignment.label"
      },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "sixth",
          "label": "One-sixeth width of column"
        },
        {
          "value": "forth",
          "label": "One-forth width of column"
        },
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "sixth",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "circle",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.multicolumn.settings.background_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.multicolumn.settings.background_style.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "color",
      "id": "color_star",
      "label": "Star Color",
      "default": "#FFC107"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "navigation_on_mobile",
      "default": false,
      "label": "Show Navigation"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "Review",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label"
        },
       {
          "type": "text",
          "id": "customer_name",
          "label": "Customer Name",
          "default": "Customer Name"
        },
        {
          "type": "text",
          "id": "city_name",
          "label": "City Name",
          "default": "City"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
